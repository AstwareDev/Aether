# Build-time defaults for the Omniroute provider. Copy to .env and adjust.
# Everything here is overridable at runtime in Settings → Models & Providers
# (stored in localStorage), including keys for the other providers:
#   OpenCode Zen        https://opencode.ai/zen/v1   (key from https://opencode.ai/auth)
#   Anthropic           https://api.anthropic.com
#   LM Studio           http://localhost:1234        (no key)
#   Anthropic-compatible / OpenAI-compatible — added from the same panel.
VITE_OMNIROUTE_BASE_URL=http://localhost:20218/v1
VITE_OMNIROUTE_API_KEY=
